{
  "name": "payro-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade AI-powered payroll fintech backend for Payro",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "start:railway": "npx prisma migrate deploy && npx prisma generate && node src/app.js",
    "dev": "nodemon src/app.js",
    "build": "npm install && npx prisma generate",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate deploy",
    "prisma:migrate:dev": "npx prisma migrate dev",
    "prisma:studio": "npx prisma studio",
    "prisma:seed": "node prisma/seed.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.js"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "@aws-sdk/client-s3": "^3.540.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.2",
    "cloudinary": "^2.2.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.12",
    "socket.io": "^4.7.5",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^5.10.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
