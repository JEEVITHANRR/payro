# ═══════════════════════════════════════════════════════════════════
# Payro Backend — Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_NAME=payro-api
LOG_LEVEL=debug

# ─── Frontend URL (for email links & CORS) ───────────────────────────
APP_URL=http://localhost:5173

# ─── Database (PostgreSQL via Prisma) ───────────────────────────────
DATABASE_URL="postgresql://payro_user:payro_password@localhost:5432/payro_db?schema=public"

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── JWT Secrets (use strong random strings in production!) ─────────
JWT_ACCESS_SECRET=change_me_access_super_secret_minimum_32_chars
JWT_REFRESH_SECRET=change_me_refresh_super_secret_minimum_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── CORS ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Cloudinary (optional — for avatar/receipt uploads) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── AWS S3 (alternative to Cloudinary) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── Email / SMTP ────────────────────────────────────────────────────
# For development: use Mailtrap (https://mailtrap.io) free tier
# For production: use SendGrid, Resend, or SES
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Payro <noreply@payro.io>"
ENABLE_EMAIL_NOTIFICATIONS=false

# ─── Logging ─────────────────────────────────────────────────────────
LOG_DIR=logs

# ─── Feature flags ───────────────────────────────────────────────────
ENABLE_AI_SCHEDULER=true
