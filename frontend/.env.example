# ═══════════════════════════════════════════════════════════
# Payro Frontend — Environment Variables
# Copy to .env.local and fill in your values.
# ═══════════════════════════════════════════════════════════

# Backend API base URL (use /api/v1 when Vite proxies requests)
VITE_API_URL=/api/v1

# For production (when frontend and backend are on different domains):
# VITE_API_URL=https://api.yourapp.com/api/v1
